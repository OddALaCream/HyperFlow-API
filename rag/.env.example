# Copy this file to .env and fill in your real values.
# .env is read automatically by the scripts.
# Never commit your real .env or share the service role key.

# Gemini (Google AI Studio) API key. Free tier works.
GEMINI_API_KEY=...

# Optional: override the generation model used by query_rag.py
# GEMINI_LLM_MODEL=gemini-2.5-flash

SUPABASE_URL=https://YOUR-PROJECT.supabase.co
# Service role key: backend/local use ONLY. Never expose it in a frontend.
SUPABASE_SERVICE_ROLE_KEY=...
